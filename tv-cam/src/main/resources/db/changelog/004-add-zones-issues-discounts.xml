<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Création de la table zones -->
    <changeSet id="create-zones-table" author="rostand">
        <createTable tableName="zones">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="address" type="VARCHAR(500)"/>
            <column name="created_at" type="VARCHAR(50)"/>
            <column name="updated_at" type="VARCHAR(50)"/>
            <column name="created_by" type="BIGINT"/>
            <column name="modified_by" type="BIGINT"/>
        </createTable>
    </changeSet>

    <!-- Création de la table discounts -->
    <changeSet id="create-discounts-table" author="rostand">
        <createTable tableName="discounts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="payment_frequency" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="discount_percentage" type="DECIMAL(5,2)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="minimum_amount" type="DECIMAL(10,2)"/>
            <column name="maximum_discount_amount" type="DECIMAL(10,2)"/>
            <column name="created_at" type="VARCHAR(50)"/>
            <column name="updated_at" type="VARCHAR(50)"/>
            <column name="created_by" type="BIGINT"/>
            <column name="modified_by" type="BIGINT"/>
        </createTable>
    </changeSet>

    <!-- Création de la table issues -->
    <changeSet id="create-issues-table" author="rostand">
        <createTable tableName="issues">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="issue_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="VARCHAR(20)" defaultValue="MEDIUM"/>
            <column name="status" type="VARCHAR(20)" defaultValue="OPEN"/>
            <column name="reference_number" type="VARCHAR(100)">
                <constraints unique="true"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="assigned_to" type="BIGINT"/>
            <column name="resolved_at" type="TIMESTAMP"/>
            <column name="due_date" type="TIMESTAMP"/>
            <column name="resolution" type="TEXT"/>
            <column name="notes" type="TEXT"/>
            <column name="customer_rating" type="INT"/>
            <column name="customer_feedback" type="TEXT"/>
            <column name="created_at" type="VARCHAR(50)"/>
            <column name="updated_at" type="VARCHAR(50)"/>
            <column name="created_by" type="BIGINT"/>
            <column name="modified_by" type="BIGINT"/>
        </createTable>
    </changeSet>

    <!-- Ajout de la colonne zone_id à la table customers -->
    <changeSet id="add-zone-to-customers" author="rostand">
        <addColumn tableName="customers">
            <column name="zone_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint
                constraintName="fk_customers_zone"
                baseTableName="customers"
                baseColumnNames="zone_id"
                referencedTableName="zones"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- Création de la table user_zones pour la relation many-to-many -->
    <changeSet id="create-user-zones-table" author="rostand">
        <createTable tableName="user_zones">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="zone_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="user_zones" columnNames="user_id,zone_id"/>
        <addForeignKeyConstraint
                constraintName="fk_user_zones_user"
                baseTableName="user_zones"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_user_zones_zone"
                baseTableName="user_zones"
                baseColumnNames="zone_id"
                referencedTableName="zones"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- Ajout des contraintes foreign key pour issues -->
    <changeSet id="add-foreign-keys-issues" author="rostand">
        <addForeignKeyConstraint
                constraintName="fk_issues_customer"
                baseTableName="issues"
                baseColumnNames="customer_id"
                referencedTableName="customers"
                referencedColumnNames="id"/>
        <addForeignKeyConstraint
                constraintName="fk_issues_assigned_user"
                baseTableName="issues"
                baseColumnNames="assigned_to"
                referencedTableName="users"
                referencedColumnNames="id"/>
    </changeSet>

    <!-- Insertion des rôles par défaut -->
    <changeSet id="insert-default-roles" author="rostand">
        <insert tableName="roles">
            <column name="name" value="ADMIN"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="CHEF_CABLEUR"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="TECHNICIEN"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="RECOUVREUR"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="MANAGER"/>
        </insert>
    </changeSet>

    <!-- Insertion des rabais par défaut -->
    <changeSet id="insert-default-discounts" author="rostand">
        <insert tableName="discounts">
            <column name="payment_frequency" value="QUARTERLY"/>
            <column name="discount_percentage" value="5.00"/>
            <column name="description" value="Rabais de 5% pour paiement trimestriel"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
        <insert tableName="discounts">
            <column name="payment_frequency" value="SEMI_ANNUALLY"/>
            <column name="discount_percentage" value="8.00"/>
            <column name="description" value="Rabais de 8% pour paiement semestriel"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
        <insert tableName="discounts">
            <column name="payment_frequency" value="ANNUALLY"/>
            <column name="discount_percentage" value="12.00"/>
            <column name="description" value="Rabais de 12% pour paiement annuel"/>
            <column name="is_active" valueBoolean="true"/>
        </insert>
    </changeSet>

</databaseChangeLog>
