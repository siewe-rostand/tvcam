<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="008-create-zones-table" author="rostand">
        <createTable tableName="zones">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="code" type="VARCHAR(10)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="created_by" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="modified_by" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="updated_at" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="009-create-user-zones-table" author="rostand">
        <createTable tableName="user_zones">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="zone_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="is_primary_zone" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="assigned_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="created_by" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="modified_by" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="updated_at" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </createTable>
        
        <addForeignKeyConstraint
                baseTableName="user_zones"
                baseColumnNames="user_id"
                constraintName="fk_user_zones_user"
                referencedTableName="users"
                referencedColumnNames="id"/>
                
        <addForeignKeyConstraint
                baseTableName="user_zones"
                baseColumnNames="zone_id"
                constraintName="fk_user_zones_zone"
                referencedTableName="zones"
                referencedColumnNames="id"/>
                
        <addUniqueConstraint
                tableName="user_zones"
                columnNames="user_id,zone_id"
                constraintName="uk_user_zone"/>
    </changeSet>

    <changeSet id="010-add-zone-to-customers" author="rostand">
        <addColumn tableName="customers">
            <column name="zone_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        
        <addForeignKeyConstraint
                baseTableName="customers"
                baseColumnNames="zone_id"
                constraintName="fk_customers_zone"
                referencedTableName="zones"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="011-insert-default-zones" author="rostand">
        <insert tableName="zones">
            <column name="name" value="Zone Centre"/>
            <column name="code" value="ZC"/>
            <column name="description" value="Zone du centre de Yaoundé"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="created_at" value="2024-01-01 00:00:00"/>
        </insert>
        
        <insert tableName="zones">
            <column name="name" value="Zone Nord"/>
            <column name="code" value="ZN"/>
            <column name="description" value="Zone nord de Yaoundé"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="created_at" value="2024-01-01 00:00:00"/>
        </insert>
        
        <insert tableName="zones">
            <column name="name" value="Zone Sud"/>
            <column name="code" value="ZS"/>
            <column name="description" value="Zone sud de Yaoundé"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="created_at" value="2024-01-01 00:00:00"/>
        </insert>
        
        <insert tableName="zones">
            <column name="name" value="Zone Est"/>
            <column name="code" value="ZE"/>
            <column name="description" value="Zone est de Yaoundé"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="created_at" value="2024-01-01 00:00:00"/>
        </insert>
        
        <insert tableName="zones">
            <column name="name" value="Zone Ouest"/>
            <column name="code" value="ZO"/>
            <column name="description" value="Zone ouest de Yaoundé"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="created_at" value="2024-01-01 00:00:00"/>
        </insert>
    </changeSet>

</databaseChangeLog>