            <column name="priority_level" value="URGENT"/>
            <column name="estimated_resolution_time" value="48"/>
            <column name="created_at" value="2024-01-01 00:00:00"/>
        </insert>
        
        <insert tableName="issue_types">
            <column name="name" value="Problème de décodeur"/>
            <column name="code" value="DECODER_ISSUE"/>
            <column name="description" value="Problème avec le décodeur de télévision"/>
            <column name="priority_level" value="MEDIUM"/>
            <column name="estimated_resolution_time" value="24"/>
            <column name="created_at" value="2024-01-01 00:00:00"/>
        </insert>
        
        <insert tableName="issue_types">
            <column name="name" value="Câblage défectueux"/>
            <column name="code" value="CABLE_DAMAGE"/>
            <column name="description" value="Câbles endommagés ou défectueux"/>
            <column name="priority_level" value="HIGH"/>
            <column name="estimated_resolution_time" value="24"/>
            <column name="created_at" value="2024-01-01 00:00:00"/>
        </insert>
        
        <insert tableName="issue_types">
            <column name="name" value="Réclamation facture"/>
            <column name="code" value="BILLING_COMPLAINT"/>
            <column name="description" value="Réclamation concernant la facturation"/>
            <column name="priority_level" value="MEDIUM"/>
            <column name="estimated_resolution_time" value="72"/>
            <column name="created_at" value="2024-01-01 00:00:00"/>
        </insert>
        
        <insert tableName="issue_types">
            <column name="name" value="Demande de déplacement"/>
            <column name="code" value="RELOCATION_REQUEST"/>
            <column name="description" value="Demande de déplacement d'installation"/>
            <column name="priority_level" value="LOW"/>
            <column name="estimated_resolution_time" value="120"/>
            <column name="created_at" value="2024-01-01 00:00:00"/>
        </insert>
        
        <insert tableName="issue_types">
            <column name="name" value="Autre"/>
            <column name="code" value="OTHER"/>
            <column name="description" value="Autres types de problèmes"/>
            <column name="priority_level" value="MEDIUM"/>
            <column name="estimated_resolution_time" value="48"/>
            <column name="created_at" value="2024-01-01 00:00:00"/>
        </insert>
    </changeSet>

</databaseChangeLog>