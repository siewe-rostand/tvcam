<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="1740501667429-1" author="siewe-rostand">
        <preConditions>
            <not>
                <tableExists tableName="customers"/>
            </not>
        </preConditions>

        <createTable tableName="customers">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" unique="true"/>
            </column>
            <column name="ref" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="telephone" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="name" type="VARCHAR(255)"/>
            <column name="address" type="VARCHAR(255)"/>
            <column name="has_debt" type="BOOLEAN"/>
            <column name="has_paid" type="BOOLEAN"/>
            <column name="is_active" type="BOOLEAN"/>
            <column name="is_suspended" type="BOOLEAN"/>
            <column name="payment_frequency" type="VARCHAR(50)"/>
            <column name="last_bill_generation_date" type="TIMESTAMP"/>
            <column name="created_by" type="BIGINT"/>
            <column name="created_at" type="varchar(255)"/>
            <column name="modified_by" type="BIGINT"/>
            <column name="updated_at" type="VARCHAR(255)"/>

        </createTable>
    </changeSet>
</databaseChangeLog>